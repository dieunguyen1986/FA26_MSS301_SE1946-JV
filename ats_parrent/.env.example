# Copy these names into the IntelliJ Run Configuration > Environment variables.
# Do not commit real values. The Config Server must start before the other applications.

# Docker Compose credentials
POSTGRES_USER=ats
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=postgres
MINIO_BUCKET=ats-cv
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-password

# Config Server
CONFIG_SERVER_PORT=8888
CONFIG_SERVER_PROFILE=native
CONFIG_SERVER_URL=http://localhost:8888
CONFIG_SERVER_USERNAME=config-admin
CONFIG_SERVER_PASSWORD=change-this-password
# Optional when IntelliJ Working directory is not the project root.
# CONFIG_SERVER_NATIVE_SEARCH_LOCATIONS=file:/absolute/path/to/ats_parrent/config-repo

# Set CONFIG_SERVER_PROFILE=git in production and provide the private config repository.
# CONFIG_REPO_URI=https://git.example.com/company/ats-config.git
# CONFIG_REPO_BRANCH=main
# CONFIG_REPO_USERNAME=git-user
# CONFIG_REPO_PASSWORD=git-token

# Shared service discovery
EUREKA_SERVER_URL=http://localhost:8761/eureka/
CV_PARSE_SERVICE_PORT=8085

# Local database credentials (one database/user per service is recommended in production)
JOB_DB_USERNAME=ats
JOB_DB_PASSWORD=change-this-password
CANDIDATE_DB_USERNAME=ats
CANDIDATE_DB_PASSWORD=change-this-password
APPLICATION_DB_USERNAME=ats
APPLICATION_DB_PASSWORD=change-this-password

# CV parsing integrations
RABBITMQ_USERNAME=ats
RABBITMQ_PASSWORD=change-this-password
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=change-this-password
CV_MAX_FILE_SIZE=10MB

# API Gateway / Keycloak OIDC (local Docker Keycloak)
APP_OIDC_ISSUER=http://localhost:8180/realms/ats
APP_OIDC_JWK_SET_URI=http://localhost:8180/realms/ats/protocol/openid-connect/certs
# Optional for local training. Set this in production after adding a Keycloak
# Audience Mapper to the access token, for example: ats-api.
APP_OIDC_AUDIENCE=
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
